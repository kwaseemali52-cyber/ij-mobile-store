<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dice Game</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#1e293b;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
color:#fff;
}

.container{
background:#334155;
padding:30px;
border-radius:15px;
text-align:center;
width:90%;
max-width:400px;
box-shadow:0 10px 20px rgba(0,0,0,.4);
}

h1{
margin-bottom:20px;
}

.dice{
font-size:100px;
margin:20px 0;
transition:.3s;
}

button{
background:#22c55e;
color:#fff;
border:none;
padding:15px 30px;
border-radius:10px;
font-size:18px;
cursor:pointer;
}

button:hover{
background:#16a34a;
}

#result{
margin:20px 0;
font-size:22px;
font-weight:bold;
}

.score{
display:flex;
justify-content:space-between;
margin-top:20px;
font-size:18px;
}
</style>

</head>

<body>

<div class="container">

<h1>🎲 Dice Game</h1>

<div class="dice" id="dice">🎲</div>

<div id="result">Press Roll Dice</div>

<button onclick="rollDice()">Roll Dice</button>

<div class="score">
<div>Wins: <span id="wins">0</span></div>
<div>Losses: <span id="losses">0</span></div>
</div>

</div>

<script>

let wins=0;
let losses=0;

const faces=[
"⚀","⚁","⚂","⚃","⚄","⚅"
];

function rollDice(){

const n=Math.floor(Math.random()*6)+1;

document.getElementById("dice").textContent=faces[n-1];

if(n>=4){
wins++;
document.getElementById("result").innerHTML="🎉 You Win! ("+n+")";
document.getElementById("result").style.color="#22c55e";
}else{
losses++;
document.getElementById("result").innerHTML="😢 You Lose! ("+n+")";
document.getElementById("result").style.color="#ef4444";
}

document.getElementById("wins").textContent=wins;
document.getElementById("losses").textContent=losses;

}

</script>

</body>
</html>
